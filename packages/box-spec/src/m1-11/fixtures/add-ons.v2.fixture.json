      "name": "RoyaltyDestination",
      "members": [
        {
          "name": "FEE_HANDLING",
          "value": 1
        },
        {
          "name": "CREATOR",
          "value": 2
        },
        {
          "name": "POOL_DEPTH",
          "value": 3
        }
      ]
    }
  ],
