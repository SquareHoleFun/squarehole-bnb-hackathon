pragma solidity ^0.8.26;

interface BatchVm {
    function readFile(string calldata path) external view returns (string memory);
    function parseBytes(string calldata value) external pure returns (bytes memory);
    function parseJsonUint(string calldata json, string calldata key) external pure returns (uint256);
    function etch(address target, bytes calldata code) external;
    function cool(address target) external;
}

/** Conservative per-view envelope: sixteen cold slots and 512 response bytes, each at a distinct cold address.
 * This is a stress measurement, not a claim to have executed the deployment's real state. */
contract ColdKeeperView {
    fallback() external {
        assembly {
            for { let i := 0 } lt(i, 16) { i := add(i, 1) } { mstore(mul(i, 32), sload(i)) }
            return(0, 512)
        }
    }
}

/** Uses viem's pinned Multicall3 creation bytecode. Inputs are generated by the offline TS capacity fixture. */
contract KeeperBatchGasTest {
    BatchVm private constant vm = BatchVm(address(uint160(uint256(keccak256("hevm cheat code")))));
    struct Call { address target; bool allowFailure; bytes callData; }
    event log_named_uint(string key, uint256 value);

    function test2048() public { measure("2048"); }
    function test8192() public { measure("8192"); }
    function test16384() public { measure("16384"); }
    function test32768() public { measure("32768"); }

    function measure(string memory bound) private {
        string memory measurements = vm.readFile("counts.json");
        uint256 count = vm.parseJsonUint(measurements, string.concat(".b", bound, ".calls"));
        uint256 inputBytes = vm.parseJsonUint(measurements, string.concat(".b", bound, ".inputBytes"));
        bytes memory creation = vm.parseBytes(vm.readFile("multicall.hex"));
        address multicall;
        assembly { multicall := create(0, add(creation, 32), mload(creation)) }
        require(multicall != address(0));
        Call[] memory calls = new Call[](count);
        for (uint256 i; i < count; i++) {
            address target = address(uint160(10000 + i));
            vm.etch(target, type(ColdKeeperView).runtimeCode);
            vm.cool(target);
            calls[i] = Call(target, true, hex"12345678");
        }
        bytes memory input = abi.encodeWithSignature("aggregate3((address,bool,bytes)[])", calls);
        vm.cool(multicall);
        uint256 start = gasleft();
        (bool ok, bytes memory result) = multicall.call(input);
        uint256 gas = start - gasleft() + 21000 + 16 * inputBytes;
        require(ok);
        // ABI bytes for (bool, bytes)[count], each containing exactly 512 bytes.
        require(result.length == 64 + count * (128 + 512));
        if (keccak256(bytes(bound)) == keccak256("16384")) {
            require(gas < 25_000_000, "less than half of a 50M eth_call cap");
            require(result.length * 2 + 256 < 1_048_576, "hex JSON below a conservative 1 MiB response budget");
        }
        emit log_named_uint("subcalls", count);
        emit log_named_uint("gas with conservative calldata cost", gas);
        emit log_named_uint("stress response bytes", result.length);
    }
}
