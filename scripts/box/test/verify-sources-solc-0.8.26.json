      "src/Example.sol": {
        "content": "// SPDX-License-Identifier: MIT\npragma solidity 0.8.26;\nimport {Library, Second} from \"./Library.sol\";\ncontract Example {\n    function value(uint256 x) external pure returns (uint256) {\n        return Library.increment(x) + Second.increment(x);\n    }\n}\n"
      },
      "src/Library.sol": {
        "content": "// SPDX-License-Identifier: MIT\npragma solidity 0.8.26;\nlibrary Library {\n    function increment(uint256 x) external pure returns (uint256) { return x + 1; }\n}\nlibrary Second {\n    function increment(uint256 x) external pure returns (uint256) { return x + 2; }\n}\n"
      }
    },
