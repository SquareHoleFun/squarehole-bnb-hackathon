{
  "name": "@squarehole/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:chain": "playwright test --config playwright.chain.config.ts",
    "e2e:core-chain": "playwright test --config playwright.core-chain.config.ts",
    "e2e:core-v2-chain": "playwright test --config playwright.core-v2-chain.config.ts",
    "e2e:alpha-trade": "playwright test --config playwright.alpha-trade.config.ts",
    "e2e:alpha-access": "playwright test --config playwright.alpha-access.config.ts",
    "e2e:examples": "node e2e/core-v2-chain/examples/run.mjs",
    "e2e:core-v2-shop": "playwright test --config e2e/core-v2-chain/shop/playwright.config.mjs",
    "build:production": "SH_BUILD=production tsc --noEmit -p . && SH_BUILD=production vite build",
    "preview:production": "vite preview --host 127.0.0.1 --port 5397 --strictPort",
    "check:production": "node production-check.ts",
    "e2e:production": "playwright test --config playwright.production.config.ts",
    "e2e:sepolia-readonly": "playwright test --config playwright.sepolia-readonly.config.ts"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.51.0",
    "@squarehole/artwork": "workspace:*",
    "@squarehole/box-spec": "workspace:*",
    "@squarehole/cards": "workspace:*",
    "@squarehole/chain": "workspace:*",
    "@squarehole/design": "workspace:*",
    "@squarehole/domain": "workspace:*",
    "@squarehole/indexer": "workspace:*",
    "@squarehole/links": "workspace:*",
    "@squarehole/providers": "workspace:*",
    "@tanstack/react-query": "5.103.2",
    "lightweight-charts": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "viem": "2.56.8",
    "vite": "8.3.1"
  }
}
