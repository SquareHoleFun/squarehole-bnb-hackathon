# Cloudflare Pages response headers for the static files. functions/_middleware.js sets the same /* block on the
# responses it serves; test/site.test.js keeps the two equal. No scripts and no inline styles on the site, so the policy
# allows only same-origin pictures, styles, fonts and the web manifest.
/*
  Content-Security-Policy: default-src 'none'; img-src 'self'; style-src 'self'; font-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=86400
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: accelerometer=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/art/*
  Cache-Control: public, max-age=604800

/fonts/*
  Cache-Control: public, max-age=604800

/brand/*
  Cache-Control: public, max-age=604800
