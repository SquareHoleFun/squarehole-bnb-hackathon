{
  "name": "pile-launch-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5471 --strictPort",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5471 --strictPort",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "e2e": "playwright test",
    "chain:build": "cd e2e/chain && forge build",
    "chain:seed": "node scripts/seed-local.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@privy-io/react-auth": "3.51.0",
    "@stripe/stripe-js": "1.54.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
