# The alpha's starter sender on chain 97 (SH-275): <SH_BNB_ETC>/alpha-sender.env, made from this file, 0600, the
# stack's user. Compose reads the values raw: no quotes, no comment after a value. Read only with SH_BNB_ALPHA=1.
# Set by compose.yaml, not here: SH_ALPHA_CHAIN_ID=97. Fixed in code (infra/server/services/alpha/chains.mjs): 0.015 tBNB
# per claim, at most 100 claims a day, no admission step; twelve confirmations; a 400,000 gas cap; a 50 gwei fee ceiling.
# Off (0), dry-run (signs nothing, marks each claim "dry run" so the person can claim again), then live; live reads the
# key file <SH_BNB_ETC>/alpha-sender/desk.key, installed by sender-key.sh from a Foundry keystore.
SH_SERVICE_ENABLED=0
SH_SERVICE_MODE=dry-run
SH_SERVICE_ALLOW_MAINNET=0
# publicnode, as the keeper's first endpoint (keeper.env).
SH_KEEPER_RPC_URL=https://bsc-testnet-rpc.publicnode.com
# The sender's wallet: the one desk.key belongs to (keystore hack-sender).
SH_ALPHA_DESK_ADDRESS=0xF7A6383a473747B6Cf80b331E204e7e273191A4d
# Chain 97's test coin (tETH, packages/chain/src/trade-sepolia/coin-deployment-97.json). The sender calls nothing on it
# here (its faucet is open); the address names the sender's journal, as on Sepolia.
SH_ALPHA_TETH=0x860822580d4eb2529de0c74c3e2b1d6d7c183302
# Optional: the low-float alert in wei; default five starters (0.075 tBNB).
# SH_ALPHA_LOW_FLOAT_WEI=75000000000000000
