# The alpha's sign-in service on chain 97 (SH-275): <SH_BNB_ETC>/alpha-api.env, made from this file, 0600, the stack's
# user. Compose reads the values raw: no quotes, no comment after a value. Read only with SH_BNB_ALPHA=1 in stack.env.
# Set by compose.yaml, not here: SH_ALPHA_CHAIN_ID=97, SH_ALPHA_AUTO_APPROVE=1 (a new sign-up is approved at once; no
# desk), SH_ALPHA_ORIGIN=https://<SH_BNB_HOST>, SH_ALPHA_COOKIE_KEY_FILE (the key is made on the first start, never seen).
# 0: the service reads nothing and does not listen (the site's /alpha/ answers 503); 1 once the Privy lines are filled.
SH_ALPHA_ENABLED=0
# The hackathon site's own Privy app (public).
SH_ALPHA_PRIVY_APP_ID=cmwwb2y9p00gv0gl9m9im0uve
# Every public key of that app's key set (1 to 4 P-256 PEMs) on one line, literal \n sequences, no quotes: print it with
#   node infra/server/services/alpha/privy-keys.mjs <saved https://auth.privy.io/api/v1/apps/<app id>/jwks.json>
SH_ALPHA_PRIVY_VERIFICATION_KEY=<the line privy-keys.mjs prints, without its SH_ALPHA_PRIVY_VERIFICATION_KEY= prefix>
# Sign-ups in all (approved at once up to this number; the next new one is refused). The default is 100.
SH_ALPHA_SIGNUP_CAP=100
