# The keeper on BNB Chain testnet (chain id 97): the settings of the hackathon stack (SH-259 Part 3).
# The machine's bootstrap copies this file to the stack's settings folder (owner-only, 0600) and the runbook fills the
# one <...> placeholder. The chain, the registry and the start block are NOT set here: every ship derives them from the
# approved release manifest (ship.sh step 3) and refuses a keeper.env that sets them. Compose reads the values raw: no quotes, no comment after a value.
# The service flags and the key file are infra/server/services' (runtime.mjs): absent or SH_SERVICE_ENABLED=0 is off;
# dry-run simulates and sends nothing; live needs the key file, made on the machine (create-keeper-key.mjs).
SH_SERVICE_ENABLED=0
SH_SERVICE_MODE=dry-run
SH_SERVICE_ALLOW_MAINNET=0
SH_KEEPER_KEY_FILE=/run/service-config/gas.key
# publicnode serves eth_getLogs over 50,000 blocks; the fallback serves at most 5,000 (probe of 25 November).
# The official dataseed endpoints refuse eth_getLogs for any range, so they are not used here.
SH_KEEPER_RPC_URL=https://bsc-testnet-rpc.publicnode.com
SH_KEEPER_RPC_FALLBACK_URL=https://bsc-prebsc-dataseed.bnbchain.org
SH_KEEPER_ADDRESS=<the keeper wallet address, the one the key file belongs to>
# The chain runs Osaka's rules (CLZ and P256VERIFY answer, eth_config names no later fork) with the per-transaction
# gas cap of EIP-7825 (2^24), and no Amsterdam state-gas reservoir.
SH_KEEPER_DESTINATION_FORK=osaka
SH_KEEPER_TRANSACTION_GAS_CAP=16777216
# Fees: NOT here. The floor (0.1 gwei) and the ceiling (0.2 gwei) come from the approved keeper-fees-97.json (ship.sh
# refuses a keeper.env that sets either). The base fee is 0: a send is signed once at the tick's eth_gasPrice plus a
# quarter, between the two; above the ceiling, or without a valid quote, the keeper waits.
# Daily budgets in tBNB wei, for a wallet float of about 0.005 tBNB: no day can reserve more than 0.004 tBNB in all.
# Each send reserves its whole signed gas limit at its fee before broadcast, settled to what it paid once its receipt is
# final. At 0.125 gwei (the quote of 0.1 plus a quarter) a graduation reserves 0.0016875 tBNB (13.5 million gas), a
# closing (fail) 0.001875 (15 million); at the 0.2 gwei ceiling 0.0027 and 0.003; runbook "What the keeper spends".
# ours 0.004 tBNB, of which the last 0.0015 only for recovery jobs; ceiling 0.004. At the usual signed price (0.125
# gwei) 0.0015 is less than one closing (0.001875) or one graduation (0.0016875): such a job waits for the next day
# when ordinary work has used the rest; the day's 0.004 holds one closing and one graduation together (0.0035625).
# No box 0 on this chain: no pokes. No hidden draws: no drand rescue spending.
SH_KEEPER_OURS_WEI_PER_DAY=4000000000000000
SH_KEEPER_RESERVE_WEI_PER_DAY=1500000000000000
SH_KEEPER_TOTAL_WEI_PER_DAY=4000000000000000
SH_KEEPER_POKES_WEI_PER_DAY=0
SH_KEEPER_DRAND_RESCUE_WEI_PER_DAY=0
# Pacing at 0.45 s blocks: a block poll every 2 s; a refused job is tried again after 66 blocks (about 30 s, where 25
# blocks of 12 s were 5 minutes); a waiting buy is reported after 8,000 blocks (an hour, as 300 blocks of 12 s).
SH_KEEPER_POLL_MS=2000
SH_KEEPER_RETRY_BLOCKS=66
SH_KEEPER_BUYBACK_ALERT_BLOCKS=8000
