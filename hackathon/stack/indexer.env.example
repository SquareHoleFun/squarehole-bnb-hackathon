# The indexer on BNB Chain testnet (chain id 97): the hackathon stack's settings (SH-259). bootstrap.sh copies this
# file to <SH_BNB_ETC>/indexer.env and fills the art origin with the host name. Plain settings: change an endpoint
# here and restart the indexer (runbook "Point the stack at another endpoint"); nothing is rebuilt.
# The two endpoints of chain 97 that serve eth_getLogs (probe of 25 November: publicnode 50,000 blocks a read, the
# second 5,000); the official dataseed endpoints refuse eth_getLogs for every range.
SH_CORE_HTTP_URLS=https://bsc-testnet-rpc.publicnode.com,https://bsc-prebsc-dataseed.bnbchain.org
# New heads over a socket (publicnode delivered every block); without it the 1 s poll serves.
SH_CORE_WS_URLS=wss://bsc-testnet-rpc.publicnode.com
# 0.45 s blocks: the fast catch-up pace (packages/indexer chain-indexer.ts CorePace).
SH_CORE_BLOCK_MS=450
SH_CORE_POLL_MS=1000
SH_CORE_MANIFEST_POLL_MS=15000
# Item pictures are asked by raw CID from this machine's own checked route.
SH_CORE_ART_GATEWAYS=https://<SH_BNB_HOST>
