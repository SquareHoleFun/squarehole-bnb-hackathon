# The stack's plain settings (compose.yaml). bootstrap.sh writes them to <SH_BNB_ETC>/stack.env on the machine, with
# the host name filled in; ship.sh passes that file to docker compose. A changed value takes effect at the next
# ship.sh (the host name also rebuilds the web image, whose pages name their own origin).
# The host name: by default the machine's public IPv4 address with dashes, under sslip.io (no DNS step); a real name
# whose A record points at the machine can replace it.
SH_BNB_HOST=<the machine address with dashes>.sslip.io
SH_BNB_ETC=/etc/squarehole-bnb
SH_BNB_SRV=/srv/squarehole-bnb
# Where Caddy listens: 0.0.0.0 on the machine; 127.0.0.1 for a trial that must not be reachable from outside.
SH_BNB_LISTEN=0.0.0.0
SH_BNB_HTTP_PORT=80
SH_BNB_HTTPS_PORT=443
# The indexer's gateway for checks from the machine itself (always on 127.0.0.1).
SH_BNB_GATEWAY_PORT=5494
# The candidate of every ship (ship.sh step 6a: the release without its keeper, checked before it serves), on 127.0.0.1.
SH_BNB_CANDIDATE_GATEWAY_PORT=5495
SH_BNB_CANDIDATE_HTTP_PORT=5496
SH_BNB_CANDIDATE_HTTPS_PORT=5497
# The Four.meme rail's creation signer at /launches/api/four/ (hackathon/stack/sign/): 1 runs it (it needs the folder
# <etc>/sign: keystore.json, password and out/, the real run's records); 0 leaves the route a plain 503.
SH_BNB_SIGN=0
# SH-287: the signer's kind tax-rules (lane g's taxRules). 1 only after bounties/openfour/scripts/rules-run.sh printed
# "the rules run is complete" and its three records are in <etc>/sign/out (bounties/openfour/sign/README.md); with 1
# and the records missing the signer stays off for every kind. Unset or 0: today's signer.
SH_BNB_SIGN_TAX_RULES=0
# SH-307: the signer's limits, whole numbers; unset: 600 signatures per client address an hour, 5 per creator an hour,
# 20,000 a day (a refused request costs none; all requests of one address: five times the first). The day's number is a
# last stop for the whole site, not a share: keep it well above 24 times the hourly number, so that one address alone
# (600 an hour, 14,400 a day) can never use up the day and leave every other visitor refused until 00:00 UTC. Change
# one: this line, then the signer alone recreated, as for SH_BNB_SIGN_TAX_RULES.
# SH_BNB_SIGN_PER_CLIENT_HOUR=600
# SH_BNB_SIGN_PER_CREATOR_HOUR=5
# SH_BNB_SIGN_PER_DAY=20000
# The alpha's sign-in at /join/ and "Set me up" (SH-275: alpha.compose.yaml; runbook hackathon/runbooks/alpha.md).
# 1 runs alpha-api and alpha-sender (they need <etc>/alpha-api.env, <etc>/alpha-sender.env and the folder
# <etc>/alpha-sender); 0 leaves the stack and the site exactly as without them.
SH_BNB_ALPHA=0
