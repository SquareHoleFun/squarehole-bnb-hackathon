# Defaults for the indexer container (compose.yaml). Keyless public Sepolia endpoints, none a secret: the HTTP list is
# the repository's .env (SEPOLIA_RPC_URL, then SEPOLIA_RPC_FALLBACKS) in that fallback order, the websocket head feeds
# are the realtime PoC's (packages/indexer/src/config.ts SEPOLIA_PUBLIC_WS_URLS). /etc/squarehole/rpc.env on the server
# (root only, optional, the founder's Infura slot) is read after this file and overrides any line it repeats.
SH_CORE_HTTP_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.gateway.tenderly.co
SH_CORE_WS_URLS=wss://ethereum-sepolia-rpc.publicnode.com,wss://sepolia.gateway.tenderly.co
SH_CORE_POLL_MS=2000
SH_CORE_MANIFEST_POLL_MS=15000
# Consumer appends /ipfs/<raw CID>; the public origin exercises the same checked route as the Sepolia app.
SH_CORE_ART_GATEWAYS=https://api.squarehole.fun
