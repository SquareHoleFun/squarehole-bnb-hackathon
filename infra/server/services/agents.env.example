# Founder writes /etc/squarehole/agents.env with sudoedit, root:root 0600.
# Defaults off. Start enabled in dry-run; live requires a separate edit after review.
SH_SERVICE_ENABLED=0
SH_SERVICE_MODE=dry-run
SH_AGENTS_CHAIN_ID=11155111
SH_AGENTS_DAILY_BUDGET_USD=2
SH_AGENTS_API_KEY_FILE=/run/service-config/anthropic.key
SH_AGENTS_ROLES_FILE=/run/service-config/lake-house.json
SH_AGENTS_FEED_FILE=/run/service-config/feed.json
# Add SH_AGENTS_RPC_URL on the server. Never put a raw API key or signing key in this environment.
