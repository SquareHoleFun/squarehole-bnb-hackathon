# Copy to /etc/squarehole/keeper.env on the server, root:root 0600; edit privately. Compose reads raw values.
SH_SERVICE_ENABLED=0
SH_SERVICE_MODE=dry-run
SH_SERVICE_ALLOW_MAINNET=0
SH_KEEPER_CHAIN_ID=11155111
SH_KEEPER_KEY_FILE=/run/service-config/gas.key
# Required before enabling: SH_KEEPER_RPC_URL, SH_KEEPER_ADDRESS, SH_KEEPER_DESTINATION_FORK,
# SH_KEEPER_TRANSACTION_GAS_CAP, SH_KEEPER_BOX_REGISTRY and/or SH_KEEPER_BOX0, SH_KEEPER_FROM_BLOCK.
# Optional separate private sender: SH_KEEPER_PRIVATE_RPC_URL and SH_KEEPER_PRIVATE_SEND_KEY_FILE.
# Do not put raw private keys or SH_KEEPER_DRY_RUN / SH_KEEPER_ALLOW_MAINNET in this env file.
# The process supplies those to the package in memory from the service flags and mounted key files.
# Optional public fallback: SH_KEEPER_RPC_FALLBACK_URL (URL, chain checked before use).
# SH_KEEPER_DRAND_RESCUE_MAX_FEE_WEI=50000000000
# SH_KEEPER_DRAND_RESCUE_WINDOW_SECONDS=259200
# SH_KEEPER_DRAND_RESCUE_WEI_PER_DAY=50000000000000000
# SH_KEEPER_GRADUATION_BOUNTY_WEI=0
