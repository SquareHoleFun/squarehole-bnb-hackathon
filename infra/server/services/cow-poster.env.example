# Copy to /etc/squarehole/cow-poster.env on the server, root:root 0600; edit privately. Compose reads raw values.
SH_SERVICE_ENABLED=0
SH_SERVICE_MODE=dry-run
SH_SERVICE_ALLOW_MAINNET=0
SH_COW_CHAIN_ID=11155111
# Required before enabling: SH_COW_RPC_URL, a read-only RPC URL (it may carry a credential; the poster never logs it).
# Optional: SH_COW_FEE_BPS (default 500, the 5% fee skip), SH_COW_CYCLE_MS (default 600000) and SH_COW_API_BASE
# (default https://api.cow.fi/sepolia for chain 11155111). The poster holds no key and signs nothing: put none here.
