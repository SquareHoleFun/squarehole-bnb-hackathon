# Copy to /etc/squarehole/burn-bot.env on the server, root:root 0600; edit privately. Compose reads raw values.
SH_SERVICE_ENABLED=0
SH_SERVICE_MODE=dry-run
SH_SERVICE_ALLOW_MAINNET=0
SH_BOT_CONFIG=/run/service-config/runner.json
SH_BOT_SIGNER_COMMAND=/run/service-config/sign
# Add endpoint variables named by runner.json rpcEnv/serviceEnv, and the managed signer's runtime credentials.
# No raw signing key. The managed executable takes a digest on stdin and returns a signature only to the runner.
