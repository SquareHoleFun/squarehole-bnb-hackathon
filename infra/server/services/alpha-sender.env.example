# Copy to /etc/squarehole/alpha-sender.env on the server, root:root 0600; edit privately.
SH_SERVICE_ENABLED=0
SH_SERVICE_MODE=dry-run
SH_SERVICE_ALLOW_MAINNET=0
SH_ALPHA_CHAIN_ID=11155111
# Required before enabling: SH_KEEPER_RPC_URL (the keeper's Sepolia RPC), SH_ALPHA_DESK_ADDRESS,
# SH_ALPHA_TETH (the reviewed SH-TETH-ADMITTER deployment). No raw keys in environment variables.
# The 0700 root:root desk-key folder is mounted read-only only here. Install requires founder bootstrap before enabling.
# Key mount is fixed at /run/service-config/desk.key. Neither dry-run nor disabled mode reads it.
# No configuration can raise the 20/day cap, change the 0.05 starter, lower 12 confirmations or enable mainnet.

# Optional low-float alert threshold in wei (decimal string); default: five starter principals.
# Each send also needs its full quoted gas budget. This does not change the send budget.
# SH_ALPHA_LOW_FLOAT_WEI=250000000000000000
