# Public configuration only; founder copies to /etc/squarehole/alpha-api.env (root:root 0600).
# Missing file/default 0 leaves the service disabled without accessing keys, state or network.
SH_ALPHA_ENABLED=0
SH_ALPHA_ORIGIN=https://test-app.squarehole.fun
SH_ALPHA_PRIVY_APP_ID=REPLACE_WITH_PUBLIC_PRIVY_APP_ID
# Every public key in the app's Privy JWKS (1 to 4 P-256 SPKI PEMs) on one line: literal \n sequences, no quotes
# (compose format: raw). Print this line with: node infra/server/services/alpha/privy-keys.mjs <saved JWKS file>
SH_ALPHA_PRIVY_VERIFICATION_KEY=-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_FIRST_PUBLIC_KEY\n-----END PUBLIC KEY-----\n-----BEGIN PUBLIC KEY-----\nREPLACE_WITH_SECOND_PUBLIC_KEY\n-----END PUBLIC KEY-----
# A 32-byte HMAC key as 64 hex digits, root:root 0600; never a wallet key or a Privy secret.
SH_ALPHA_COOKIE_KEY_FILE=/run/alpha-config/cookie.key
SH_ALPHA_ACCESS_TEAM=https://REPLACE_WITH_TEAM.cloudflareaccess.com
SH_ALPHA_ACCESS_AUD=REPLACE_WITH_DESK_APPLICATION_AUDIENCE
