# Defaults for the card service container (compose.yaml `cards`; packages/cards/src/service/config.ts). Nothing here is
# a secret, and the service reads no file in /etc/squarehole: its RPCs are the keyless public Sepolia endpoints (the
# same list as indexer.env's SH_CORE_HTTP_URLS), used only when the indexer does not answer.
SH_CARDS_RPC_URLS=https://ethereum-sepolia-rpc.publicnode.com,https://sepolia.gateway.tenderly.co
# HTTPS origins only: the consumer appends /ipfs/<raw CID>, checks the spec's hash, and bounds reads to 3 s / 1 MiB.
# Same checked, local-block route as the Sepolia browser; do not add /ipfs/ here or bypass the guard with Kubo's API.
SH_CARDS_ART_GATEWAYS=https://api.squarehole.fun
SH_CARDS_ENGINE=native
